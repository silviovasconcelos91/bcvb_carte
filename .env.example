# Projet Supabase : Project Settings > API Keys (URL du projet et clé publishable).
# Sans ces deux valeurs, le site tourne en mode démo avec des données fictives.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Obligatoire avec Supabase : domaine des adresses internes des comptes.
# Un pseudo « Léa Martin » devient l'adresse cartes-lea.martin@<domaine>. Aucun e-mail n'y est envoyé,
# mais Supabase refuse les domaines sans enregistrements MX (example.com, test.com, localhost…) :
# prends celui du club. Mets la même valeur dans LOGIN_EMAIL_DOMAIN de .env.admin.
VITE_LOGIN_EMAIL_DOMAIN=

# Nom du club affiché sur le site, le paquet et le dos des cartes
VITE_CLUB_NAME=BCVB
VITE_CLUB_SHORT=BCVB

# Facultatif : adresse du jeu imprimée dans les QR codes (par défaut, l'adresse du site)
VITE_APP_URL=
